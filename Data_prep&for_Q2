raw_data = 'S1 Ageing Study Dataset.csv'
clean_data = 'Cleaned_S1_Ageing_Study_Dataset_Cleaned.csv'

# Step 1: Run Data Cleaning_NC
clean_dataset(raw_data, clean_data)
